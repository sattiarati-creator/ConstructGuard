# ==========================================
# ConstructGuard Computer Vision Service (.env)
# ==========================================

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=INFO

# YOLO Object Detection Configuration
# Supported options: yolo11n.pt, yolov8n.pt, or path to custom trained weights
MODEL_NAME=yolo11n.pt
CONFIDENCE_THRESHOLD=0.40
IMAGE_SIZE=640

# File Upload Constraints
MAX_IMAGE_SIZE_MB=15.0

# OpenCV Image Change Detection Parameters
MIN_CONTOUR_AREA=500.0
CHANGE_THRESHOLD=25.0
LOW_CHANGE_THRESHOLD=10.0
MEDIUM_CHANGE_THRESHOLD=25.0
HIGH_CHANGE_THRESHOLD=50.0
