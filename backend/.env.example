PORT=5000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/constructguard
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN=http://localhost:5173

# Redis & BullMQ Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
QUEUE_RETRY_ATTEMPTS=3
QUEUE_BACKOFF_MS=2000
WORKER_CONCURRENCY=3
CV_SERVICE_URL=http://localhost:8000

# MQTT Configuration
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=constructguard/sites
MQTT_CLIENT_ID=constructguard-backend-consumer

# Sensor Simulator Configuration
PUBLISH_INTERVAL_MS=5000
ANOMALY_PROBABILITY=0.10
