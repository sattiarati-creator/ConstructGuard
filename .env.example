# ==========================================
# ConstructGuard Environment Variables
# ==========================================

# --- System & Deployment ---
NODE_ENV=development
LOG_LEVEL=info

# --- Backend API Service ---
PORT=5000
API_PREFIX=/api
CORS_ORIGIN=http://localhost:5173

# --- PostgreSQL Database ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=constructguard
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/constructguard
